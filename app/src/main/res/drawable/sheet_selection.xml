<?xml version="1.0" encoding="utf-8"?>
<!--
    The band across the middle of the three wheels marking the selected row.
    Drawn behind the columns so the highlighted values read as one line.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1FABE83F" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#59ABE83F" />
</shape>
