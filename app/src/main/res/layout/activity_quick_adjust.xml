<?xml version="1.0" encoding="utf-8"?>
<!--
    Half-screen sheet opened by tapping the widget. Three wheels — page, surah,
    ayah — scrolled independently, then committed with one button. Nothing is
    written until "تطبيق التغييرات" is pressed.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/sheet_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/sheet_bg"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="18dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="42dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/sheet_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="أين وصلت؟"
            android:textColor="#F1F4EC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheet_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="3dp"
            android:text="اسحب لاختيار موضعك"
            android:textColor="#8D977F"
            android:textSize="12sp" />

        <!-- Column headers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="الصفحة"
                android:textColor="#ABE83F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.35"
                android:gravity="center"
                android:text="السورة"
                android:textColor="#ABE83F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="الآية"
                android:textColor="#ABE83F"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Wheels, with the selection band drawn behind them -->
        <FrameLayout
            android:id="@+id/sheet_wheels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="150dp"
            android:layout_marginTop="6dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/sheet_selection" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/sheet_column_bg">

                    <NumberPicker
                        android:id="@+id/picker_page"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:theme="@style/SheetPickerTheme" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.35"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/sheet_column_bg">

                    <NumberPicker
                        android:id="@+id/picker_surah"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:theme="@style/SheetPickerTheme" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/sheet_column_bg">

                    <NumberPicker
                        android:id="@+id/picker_ayah"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:theme="@style/SheetPickerTheme" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/sheet_apply"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/sheet_apply_btn"
            android:gravity="center"
            android:text="تطبيق التغييرات"
            android:textColor="#0A0F06"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</FrameLayout>
