<?xml version="1.0" encoding="utf-8"?>
<!--
    Native mushaf reader. Everything here is plain Android views drawn with a
    Typeface loaded via Typeface.createFromAsset — there is no WebView on this
    screen, so none of the browser font-loading failures that blocked the
    in-app tab (a face that registers but never gets applied to text) can
    happen here: a Typeface either loads or Android throws, with nothing in
    between and no silent fallback.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl">

    <!-- ===== Toolbar ===== -->
    <LinearLayout
        android:id="@+id/reader_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btn_pick_surah"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="9dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="الفاتحة" />

        <TextView
            android:id="@+id/btn_pick_page"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:padding="9dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="صفحة 1" />

        <TextView
            android:id="@+id/btn_font_dec"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="أ−" />

        <TextView
            android:id="@+id/btn_font_inc"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="أ+" />

        <TextView
            android:id="@+id/btn_night"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:textSize="15sp"
            android:text="🌙" />

        <TextView
            android:id="@+id/btn_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:textSize="15sp"
            android:text="✕" />
    </LinearLayout>

    <!-- Running head: juz / page / surah, mushaf style -->
    <LinearLayout
        android:id="@+id/reader_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/head_juz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="الجزء ١" />

        <TextView
            android:id="@+id/head_page"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="١" />

        <TextView
            android:id="@+id/head_surah"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="١ الفاتحة" />
    </LinearLayout>

    <!-- ===== Page ===== -->
    <ScrollView
        android:id="@+id/reader_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/reader_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- ===== Footer ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/btn_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="›" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="💾  حفظ التقدم" />

        <TextView
            android:id="@+id/btn_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="‹" />
    </LinearLayout>

    <TextView
        android:id="@+id/reader_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:textSize="10.5sp"
        android:text="اضغط على أي آية لتحديد موضع توقفك" />

</LinearLayout>
